TELEGRAM_BOT_TOKEN=replace-me
MAINTAINER_TELEGRAM_IDS=123456789
DATABASE_URL=sqlite:///data/quantbot.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HMAC_SECRET=replace-with-at-least-32-random-characters
# Optional Fernet key. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=
LOG_LEVEL=INFO
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# --- strategy (Phase 2); see README "策略接入". Install the library first: pip install -e ../BACKEND
ALPACA_API_KEY=
ALPACA_API_SECRET=
# SEC requires a contact in the User-Agent: your name and an email
SEC_USER_AGENT=
# 1 = run the strategy automatically once a month (first weekday after 10:00 New York time); 0 = only /runstrategy
STRATEGY_AUTORUN=0
# the push happens on the US first trading day of the month, at this local hour (default 10:00 UTC+8 = the evening before the US open)
# STRATEGY_PUSH_TIMEZONE=Asia/Shanghai
# STRATEGY_PUSH_HOUR=10
# QUANT_STRATEGY_HOME=data/strategy
