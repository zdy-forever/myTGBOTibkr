TELEGRAM_BOT_TOKEN=replace-me
# Required: immutable highest-privilege Telegram user ID (must verify own phone before use).
BOT_OWNER_TELEGRAM_ID=123456789
# Existing IDs are imported into SQLite only once at first startup after migration.
MAINTAINER_TELEGRAM_IDS=123456789
DATABASE_URL=sqlite:///data/quantbot.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HMAC_SECRET=replace-with-at-least-32-random-characters
# Optional Fernet key. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=
LOG_LEVEL=INFO
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# --- strategy (Phase 2); see README "策略接入". Install the library first: pip install -e ../BACKEND
ALPACA_API_KEY=
ALPACA_API_SECRET=
# SEC requires a contact in the User-Agent: your name and an email
SEC_USER_AGENT=
# 1 = automatic monthly notifications on each user's selected US trading day; 0 = only /runstrategy
STRATEGY_AUTORUN=1
# Default: first US trading day; users change it with /auto_notice_date. Pushes start at this local hour.
# STRATEGY_PUSH_TIMEZONE=Asia/Shanghai
# STRATEGY_PUSH_HOUR=10
# QUANT_STRATEGY_HOME=data/strategy

# AUD/USD automatic reference FX. Required only for AUD-funded suggestions.
# Default uses timestamped TrueFX reference bids, no API key required.
FX_PROVIDER=truefx
# Optional alternate real-time provider: FX_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
# Optional delayed public reference (not real-time): set FX_PROVIDER=yahoo explicitly.
