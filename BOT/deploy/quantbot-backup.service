[Unit]
Description=Backup Telegram Quant Portfolio SQLite database

[Service]
Type=oneshot
User=quantbot
Group=quantbot
WorkingDirectory=/opt/quantbot/app/BOT
EnvironmentFile=/opt/quantbot/app/BOT/.env
ExecStart=/opt/quantbot/conda-tg/bin/python -m quantbot.backup
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quantbot/app/BOT/data /opt/quantbot/app/BOT/backups
